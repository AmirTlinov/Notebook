{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notebook",
  "version": "0.2.3",
  "description": "Work with your agent on shared Notebook boards and pages inside Codex.",
  "author": {
    "name": "Amir Tlinov"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Notebook",
        "shortDescription": "Think and draw together",
        "longDescription": "Open your saved Notebook material beside a Codex conversation. Continue the same board or page with your agent and your iPad.",
        "developerName": "Amir Tlinov",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "logo": "./assets/notebook.png",
        "composerIcon": "./assets/notebook.png",
        "defaultPrompt": [
          "Open my Notebook",
          "Help me develop this drawing",
          "Continue the material I selected"
        ]
      }
    }
  }
}
