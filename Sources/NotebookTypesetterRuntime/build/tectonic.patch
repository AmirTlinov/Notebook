+/* Only owners without live iterators opt into growth. Equal-key entries retain
+ * their order, including the duplicate entries accepted by ht_append_table. */
+void
+ht_reserve_table (struct ht_table *ht, int min_entries)
+{
+  struct ht_entry **table;
+  unsigned int capacity, maximum;
+  int i;
+
+  assert(ht && ht->capacity > 0);
+  if (min_entries <= ht->capacity)
+    return;
+
+  maximum = UINT32_MAX / sizeof(struct ht_entry *);
+  if ((unsigned int) min_entries > maximum)
+    _tt_abort("Hash table capacity overflow.");
+  capacity = ht->capacity;
+  while (capacity < (unsigned int) min_entries) {
+    capacity = capacity > (maximum - 1) / 2 ? maximum : capacity * 2 + 1;
+  }
+  table = NEW(capacity, struct ht_entry *);
+  for (i = 0; i < (int) capacity; i++)
+    table[i] = NULL;
+
+  for (i = 0; i < ht->capacity; i++) {
+    struct ht_entry *hent = ht->table[i];
+    while (hent) {
+      struct ht_entry *next = hent->next;
+      unsigned int hkey = get_hash(hent->key, hent->keylen) % capacity;
+      hent->next = table[hkey];
+      table[hkey] = hent;
+      hent = next;
+    }
+  }
+  /* Reverse the prepended chains once: linear rehash, stable duplicate order. */
+  for (i = 0; i < (int) capacity; i++) {
+    struct ht_entry *hent = table[i], *prev = NULL;
+    while (hent) {
+      struct ht_entry *next = hent->next;
+      hent->next = prev;
+      prev = hent;
+      hent = next;
+    }
+    table[i] = prev;
+  }
+  free(ht->table);
+  ht->table = table;
+  ht->capacity = capacity;
 }
 
