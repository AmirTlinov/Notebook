+/* Notebook records the expanded special at actual shipout, in the same stream
+ * and order as source boxes. Dvipdfmx still owns PDF execution. This is not a
+ * PDF interpreter: the host admits its documented btrans/etrans subset only. */
+bool
+synctex_notebook_special(const uint16_t *text, size_t length)
+{
+    char value[2048];
+    bool ascii = length < sizeof(value);
+    for (size_t i = 0; ascii && i < length; i++) {
+        ascii = text[i] >= 32 && text[i] < 127;
+        value[i] = (char)text[i];
+    }
+    if (!ascii)
+        return false;
+    value[length] = 0;
+    char kind = 0;
+    const char *payload = "";
+    bool consume = false;
+    if (strncmp(value, "notebook:region ", 16) == 0) {
+        kind = '='; payload = value + 16; consume = true;
+    } else if (strncmp(value, "pdf:btrans", 10) == 0) {
+        kind = '+'; payload = value + 10;
+    } else if (strcmp(value, "pdf:etrans") == 0) {
+        kind = '-';
+    } else if (strncmp(value, "pdf:bcontent", 12) == 0 || strncmp(value, "pdf:econtent", 12) == 0 ||
+        ((strncmp(value, "pdf:literal", 11) == 0 || strncmp(value, "pdf:content", 11) == 0) && strstr(value, " cm"))) {
+        kind = '!'; payload = "unsupported PDF coordinate transform";
+    }
+    if (!kind || synctex_ctxt.flags.off || !INTPAR(synctex) || synctex_ctxt.file == INVALID_HANDLE)
+        return consume;
+    if (synctex_ctxt.recorder != NULL) {
+        (*synctex_ctxt.recorder)(synctex_ctxt.node);
+        synctex_ctxt.recorder = NULL;
+    }
+    int len = ttstub_fprintf(synctex_ctxt.file, "N%c%i,%i:%s\n", kind, SYNCTEX_CURH, SYNCTEX_CURV, payload);
+    if (len > 0) {
+        synctex_ctxt.total_length += len;
+        ++synctex_ctxt.count;
+    } else {
+        synctexabort();
+    }
+    return consume;
+}
