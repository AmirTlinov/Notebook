+/* Expand a format run with bounded block copies. Source and destination are
+   disjoint because each block is no larger than the initialized prefix. */
+static void
+repeat_memory_word(memory_word *base, size_t count, memory_word value)
+{
+    if (count == 0)
+        return;
+    base[0] = value;
+    for (size_t copied = 1; copied < count;) {
+        size_t n = count - copied;
+        if (n > copied)
+            n = copied;
+        if (n > 65536)
+            n = 65536;
+        memcpy(base + copied, base, n * sizeof(*base));
+        copied += n;
+    }
+}
