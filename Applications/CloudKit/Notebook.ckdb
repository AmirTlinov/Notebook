DEFINE SCHEMA

    RECORD TYPE NotebookDevices (
        "format" INT64,
        "directory" ENCRYPTED BYTES
    );

    RECORD TYPE NotebookDelivery (
        "format" INT64,
        "body" BYTES
    );

    RECORD TYPE NotebookBlob (
        "format" INT64,
        "hash" STRING,
        "offset" INT64,
        "total" INT64,
        "digest" STRING,
        "asset" ASSET
    );
